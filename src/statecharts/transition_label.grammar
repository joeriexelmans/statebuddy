start = comment / tlabel

tlabel = _ trigger:trigger? _ guard:("[" _ guard _ "]")? _ actions:("/" _ actions )? _ {
  return {
    kind: "transitionLabel",
    trigger: trigger ? trigger : {kind: "triggerless"},
    guard: guard ? guard[2] : {kind: "literal", value: true},
    actions: actions ? actions[2] : [],
  };
}

trigger = afterTrigger / entryTrigger / exitTrigger / eventTrigger

eventTrigger = event:identifier param:("(" lhs ")")? {
	return {
        kind: "event",
        event,
        param: param ? param[1] : undefined,
    };
}

afterTrigger = after:KeywordAfter _ dur:durationMs {
	return {
        kind: "after",
        durationMs: dur.valMs,
        rangeAfter: after.range,
        rangeUnit: dur.rangeUnit,
        rangeNumber: dur.rangeNumber,
    };
}

KeywordAfter = "after" {
    return {
        range: range(),
    }
}

entryTrigger = "entry" {
	return {kind: "entry", range: range()};
}

exitTrigger = "exit" {
	return {kind: "exit" , range: range()};
}


durationMs = num:number _ u:KeywordTimeUnit {
	return {
        valMs: num.value * (u.unit === "s" ? 1000 : 1),
        rangeUnit: u.range,
        rangeNumber: num.range,
    };
}

KeywordTimeUnit = KeywordMs / KeywordS

KeywordMs = "ms" {
	return { unit: text(), range: range() };
}
KeywordS = "s" {
	return { unit: text(), range: range() };
}


guard = expr

actions = head:action tail:(_ ";" _ action)* _ ";"? {
	return [head, ...tail.map(t => t[3])];
}

action = assignment / raise

assignment = lhs:lhs _ "=" _ rhs:expr {
	return {kind: "assignment", lhs, rhs};
}

lhs = lhsEmptyDict / lhsNonemptyDict / lhsEmptyArray / lhsNonemptyArray / lhsRef / lhsLiteral

lhsEmptyDict = "{" _ "}" {
    return {
        kind: "lhsDict",
        fields: [],
    };
}

lhsNonemptyDict = "{" _ head:lhsDictField tail:( _ "," _ lhsDictField)* (_ ",")? _ "}" {
    return {
        kind: "lhsDict",
        fields: Object.fromEntries([
            head,
            ...tail.map(t => t[3]),
        ]),
    };
}

lhsDictField = fieldname:identifier nested_lhs:(_ ":" _ lhs)? {
    return [
        fieldname,
        nested_lhs
            ? nested_lhs[3]
            : { kind: "lhsRef", variable: fieldname}, // <-- shorthand notation like in JS
    ];
}

lhsEmptyArray = "[" _ "]" {
    return {
        kind: "lhsArray",
        elements: [],
    }
}

lhsNonemptyArray = "[" _ head:lhs tail:( _ "," _ lhs )* (_ ",")? _ "]" {
    return {
        kind: "lhsArray",
        elements: [
            head,
            ...tail.map(t => t[3]),
        ],
    }
}

lhsRef = variable:identifier {
    return {
        kind: "lhsRef",
        variable,
        range: range(),
    };
}

lhsLiteral = literal:literal {
    return {
        kind: "lhsLiteral",
        value: literal.value,
        range: range(),
    }
}

identifier = ("_" / [a-z])+ ("_" / [a-zA-Z0-9])* {
	return text();
}

number = [0-9]+ {
	return {
        value: parseInt(text()),
        range: range(),
    };
}

expr = compare

compare = sum:sum rest:((_ ("==" / "!=" / "<=" / ">=" / "<" / ">") _) compare)? {
	if (rest === null) {
    	return sum;
    }
    return {
        kind: "binaryExpr",
        operator: rest[0][1],
        lhs: sum,
        rhs: rest[1],
    };
}

sum = prod:product rest:((_ ("+" / "-" / "||") _) sum)? {
	if (rest === null) {
    	return prod;
    }
    return {
        kind: "binaryExpr",
        operator: rest[0][1],
        lhs: prod,
        rhs: rest[1],
    };
}

product = atom:unary rest:((_ ("*" / "/" / "%" / "&&" ) _) product)? {
	if (rest === null) {
    	return atom;
    }
    return {
        kind: "binaryExpr",
        operator: rest[0][1],
        lhs: atom,
        rhs: rest[1],
    };
}

unary = operator:("!" / "-")? atom:atom {
	if (operator === null) {
       return atom;
    }
    return {
    	kind: "unaryExpr",
        operator,
        expr: atom,
    }
}

atom = fnCall / nested / literal / ref / rhs_empty_dict / rhsNonemptyDict / rhsEmptyArray / rhs_nonempty_array

rhs_empty_dict = "{" _ "}" {
    return {
        kind: "dict",
        fields: [],
    };
}

rhsNonemptyDict = "{" _ head:rhsDictField tail:(_ "," _ rhsDictField)* (_ ",")? _ "}" {
    return {
        kind: "dict",
        fields: Object.fromEntries([
            head,
            ...tail.map(t => t[3]),
        ]),
    }
}

rhsDictField = fieldname:identifier expr:(_ ":" _ expr)? {
    return [
        fieldname,
        expr
            ? expr[3]
            : { kind: "ref", variable: fieldname },
    ];
}

rhsEmptyArray = "[" _ "]" {
    return {
        kind: "array",
        elements: [],
    }
}

rhs_nonempty_array = "[" _ head:expr tail:(_ "," _ expr)* (_ ",")? _ "]" {
    return {
        kind: "array",
        elements: [
            head,
            ...tail.map(t => t[3]),
        ],
    }
}


nested = "(" _ expr:expr _ ")" {
	return expr;
}

fnCall = fn:ref param:nested {
	return {
    	kind: "call",
        fn,
        param,
    };
}

literal = value:(number / boolean / string) {
	return {kind: "literal", ...value}
}

ref = variable:identifier {
	return {kind: "ref", variable, range: range()}
}

boolean = KeywordTrue / KeywordFalse

KeywordTrue = "True" {
    return {value: true, range: range()};
}
KeywordFalse = "False" {
    return {value: false, range: range()};
}

string = '"' str:([^"]*) '"' {
	return {
        value: str.join(''),
        range: range(),
    };
}

raise = "^" _ event:identifier param:("(" expr ")")? {
	return {kind: "raise", event, param: param ? param[1] : undefined};
}

_ "whitespace"
  = (comment / [ \t\n\r])*
  { return null; }

comment = "//" _ text:.* _ ('\n' / !.) {
	return {
    	kind: "comment",
        text: text.join(''),
        range: range(),
    };
}

